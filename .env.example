# PIN de acesso ao painel administrativo (4 dígitos)
PIN=1234

# Configuração do Firebase Firestore (Opcional - se ausente, usa dados.json local)
# No Render: cole o conteúdo completo do JSON da chave em uma única linha ou use o JSON minificado
# Localmente: pode ser o caminho para o arquivo, ex: ./firebase-key.json
FIREBASE_SERVICE_ACCOUNT=./firebase-key.json
